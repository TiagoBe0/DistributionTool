# =============================================================
#  DistributionTool — .gitignore
#  Mantiene fuera de GitHub los archivos pesados (datos de
#  simulacion, artefactos de compilacion y salidas generadas).
# =============================================================

# ---------- Directorios de compilacion ----------
build/
build_*/
_build_*/
_AppDir/

# ---------- Binarios / objetos ----------
*.AppImage
*.o
*.a
*.so
*.out
packaging/tools/

# ---------- Cache de Python ----------
__pycache__/
*.pyc

# ---------- Datos de simulacion LAMMPS (PESADOS) ----------
dump.*
dump-*
*.dump
analyzed_dump.*
analyzed_dump-*
analyzed_*.config
*_void.config
*.relax
data.*

# Carpetas de barridos / datasets pesados (raiz)
5kev_20_05/
*_20_05/

# ---------- Salidas CSV generadas (PESADAS) ----------
/output.csv
outputmoiercoles.csv
output_*.csv
*output.csv
pca_output*.csv
hist_output*.csv
vacancies_output*.csv

# ---------- Resultados generados (raiz) ----------
/results/
/results_*/

# ---------- Archivos de runtime ----------
imgui.ini
*.log

# ---------- Claves / secretos ----------
*.pub
*.key
*_key
id_rsa*

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
